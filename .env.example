# Copy to .env for local dev. Missing Google or Slack settings turn that part off.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/launch_calendar
PORT=3000
# The deployed app's URL. When set, Slack reminders and the digest link to its /guide page.
APP_BASE_URL=
# Where the digest's "How it works" link goes, e.g. the handbook page. Defaults to APP_BASE_URL/guide.
HOW_IT_WORKS_URL=

# The launch calendar: Google Calendar > Settings > the calendar > Integrate calendar > Calendar ID
LAUNCH_CALENDAR_ID=
# Optional link shown in Slack and the web page, e.g. the calendar's "public URL" or a cid= link
CALENDAR_URL=

# Prototype access (option C): a Desktop app OAuth client, then `pnpm google:auth` for the token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Team access later (option B): service account with domain-wide delegation. Wins over option C when set.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=

# Slack: bot token with chat:write, users:read, users:read.email. Invite the bot to the channel.
SLACK_BOT_TOKEN=
ALERT_CHANNEL_ID=
# Kill switch. While false, every Slack post is logged instead of sent.
SLACK_POSTING_ENABLED=false

SYNC_INTERVAL_MINUTES=5
